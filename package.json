{
  "name": "flipsync",
  "version": "1.0.2",
  "description": "Zero-friction real-time file synchronization across networks via Cloudflare Tunnels, Tailscale, or LAN",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "flipsync": "dist/bin/flipsync.js",
    "flipsync-host": "dist/bin/flipsync-host.js",
    "flipsync-client": "dist/bin/flipsync-client.js"
  },
  "files": [
    "dist",
    "scripts",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "node scripts/build.js",
    "prepublishOnly": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "tsx tests/run.ts",
    "test:unit": "tsx tests/run.ts",
    "host": "tsx bin/flipsync-host.ts",
    "client": "tsx bin/flipsync-client.ts",
    "start": "tsx bin/flipsync.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/diegonoss/flipsync.git"
  },
  "bugs": {
    "url": "https://github.com/diegonoss/flipsync/issues"
  },
  "homepage": "https://github.com/diegonoss/flipsync#readme",
  "keywords": [
    "sync",
    "file-sync",
    "real-time",
    "sse",
    "cloudflare-tunnel",
    "tailscale",
    "cross-network",
    "zero-install"
  ],
  "author": "Flipsi",
  "license": "MIT",
  "devDependencies": {
    "@types/blessed": "^0.1.27",
    "@types/node": "^22.13.9",
    "esbuild": "^0.25.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  },
  "dependencies": {
    "blessed": "^0.1.81",
    "chokidar": "^5.0.0",
    "commander": "^15.0.0"
  }
}
